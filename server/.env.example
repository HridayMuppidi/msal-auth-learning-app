# Copy this file to .env — values below are safe to share for a public SPA
# (Client ID and Tenant ID are not secrets for public client apps)

# Your Azure AD app registration Client ID
CLIENT_ID=0c7237fb-e064-419c-a097-f44cd8b9bddd

# Your Azure AD Tenant ID (Joe's organisation)
TENANT_ID=bf2489d8-d07d-4e31-8a4b-5110baf6a1e2

# Microsoft's public key endpoint for this tenant — used to verify JWT signatures
JWKS_URI=https://login.microsoftonline.com/bf2489d8-d07d-4e31-8a4b-5110baf6a1e2/discovery/v2.0/keys

# Only allow requests from this origin (your React dev server)
ALLOWED_ORIGIN=http://localhost:3001
